# Base de datos (local: docker-compose / producción: Railway)
DB_HOST=localhost
DB_PORT=5440
DB_NAME=stoessel_propiedades
DB_USER=postgres
DB_PASSWORD=password
# Alternativa: una sola URL (Railway la provee como DATABASE_URL). Si está definida, tiene prioridad.
# DATABASE_URL=postgresql://user:pass@host:5432/db
# DB_SSL=true

# JWT (usar secretos largos y distintos en producción)
JWT_SECRET=your_secret_key_here_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=your_refresh_secret_here_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (Email) - solo estructura por ahora
RESEND_API_KEY=your_resend_key
EMAIL_FROM=Stoessel Propiedades <no-reply@stoessel.com>

# CORS (separar orígenes con coma)
CORS_ORIGIN=http://localhost:5173,https://tu-frontend.vercel.app

# Server
PORT=5000
NODE_ENV=development
